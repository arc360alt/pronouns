JWT_SECRET=change-this-to-a-long-random-string
PORT=3012
NODE_ENV=development
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e4b
TURNSTILE_SECRET=1x0000000000000000000000000000000AA
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Unused-upload cleanup job (defaults shown)
UPLOAD_CLEANUP_INTERVAL_MINUTES=10
# Files newer than this are never deleted, so uploads not yet saved to a profile survive
UPLOAD_CLEANUP_GRACE_MINUTES=60
# Set to 1 to only log what would be deleted
UPLOAD_CLEANUP_DRY_RUN=0
